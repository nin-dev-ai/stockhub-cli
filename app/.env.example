# StockHub optional settings. Copy the lines you need into your shell or a local .env (never commit secrets),
# then start with ./start.sh or `npm run dev` / `npm run preview` from app/.

# Live SEC filings for personas (Form 4, 13D/G). The SEC requires a name and contact in the User-Agent;
# it is sent only to sec.gov. Optional: the contact can instead be typed on the Personas screen.
# STOCKHUB_SEC_CONTACT="Your Name you@example.com"

# Interactive Brokers Client Portal Gateway (read-only sync and paper orders). On a Mac use port 5001,
# because AirPlay Receiver holds 5000.
# IBKR_GATEWAY_URL=https://localhost:5001

# Optional Claude wording for the Copilot. The key stays in the local server process.
# STOCKHUB_LLM_KEY=
# STOCKHUB_LLM_MODEL=claude-sonnet-5-5
# STOCKHUB_LLM_URL=https://api.anthropic.com

# Market data API (OpenBB), if it is not on the default port.
# STOCKHUB_API_URL=http://127.0.0.1:6900
